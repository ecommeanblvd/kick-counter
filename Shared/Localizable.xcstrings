    "onboarding.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the big circle each time you feel your baby move — a kick, roll, or flutter. When you reach 10, you're done."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào vòng tròn lớn mỗi khi cảm thấy bé cử động: đạp, xoay hay trườn. Đủ 10 lần là xong."
          }
        }
      }
    },
    "onboarding.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count 10 movements"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm 10 cử động"
          }
        }
      }
    },
    "onboarding.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From week 28, count once a day at a time your baby is usually active, such as after a meal or in the evening."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ tuần 28, mỗi ngày đếm một lần vào lúc bé hay cử động, như sau bữa ăn hoặc buổi tối."
          }
        }
      }
    },
    "onboarding.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to count"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nào nên đếm"
          }
        }
      }
    },
    "onboarding.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your baby is moving less than usual, contact your doctor or maternity unit right away. Don't wait for the app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thấy bé cử động ít hơn bình thường, hãy liên hệ ngay bác sĩ hoặc cơ sở y tế. Đừng chờ kết quả từ app."
          }
        }
      }
    },
    "onboarding.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a substitute for medical advice"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thay thế tư vấn y tế"
          }
        }
      }
    },
